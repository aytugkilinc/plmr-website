// Connected to Cloudflare Workers Builds on 2026-10-08.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plmr-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "aytugkilinc@plmrsolutions.com"
    }
  ]
}

